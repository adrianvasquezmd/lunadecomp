# Package publication files
/*
!/.Rbuildignore
!/.gitattributes
!/.gitignore
!/DESCRIPTION
!/LICENSE.md
!/NAMESPACE
!/NEWS.md
!/README.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/R-CMD-check.yaml
!/R/
/R/*
!/R/f_decomp.R
!/R/globals.R
!/R/internal.R
!/R/ke_decomp.R
!/R/lunadecomp-package.R
!/R/lunadecomp_example.R
!/R/oby_decomp.R
!/R/survey_domain.R
!/R/wvw_decomp.R
!/data/
/data/*
!/data/lunadecomp_example.rda
!/inst/
/inst/*
!/inst/CITATION
!/inst/COPYRIGHTS
!/man/
/man/*
!/man/f_decomp.Rd
!/man/ke_decomp.Rd
!/man/lunadecomp-package.Rd
!/man/lunadecomp_example.Rd
!/man/oby_decomp.Rd
!/man/wvw_decomp.Rd
